# Nettskjema OAuth 2.1 Client Credentials
# Create your API client at: https://authorization.nettskjema.no/
# Register a new client and save the clientId and clientSecret
# IMPORTANT: The clientSecret is shown only once - store it securely!

NETTSKJEMA_CLIENT_ID=your_client_id_here
NETTSKJEMA_CLIENT_SECRET=your_client_secret_here

# Note: Your API client username will be: <clientId>@apiclient
# Add this username to form permissions: Settings > Permissions > Editing permissions
